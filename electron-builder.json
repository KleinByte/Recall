{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.kleinbyte.recall",
  "productName": "Recall",
  "directories": {
    "output": "release/${version}"
  },
  "afterPack": "scripts/verify-packaged-runtime.cjs",
  "icon": "public/favicon.ico",
  "files": [
    "dist",
    "dist-electron",
    "!node_modules/better-sqlite3/build/**/*",
    "!node_modules/better-sqlite3/deps/**/*",
    "!node_modules/better-sqlite3/src/**/*",
    "!node_modules/better-sqlite3/binding.gyp",
    "!node_modules/better-sqlite3/README.md",
    "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
    "!node_modules/better-sqlite3/prebuilds/linux-*.node",
    "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
    "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
    "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
    "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
    "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll"
  ],
  "extraResources": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    {
      "from": "resources/champion-portraits",
      "to": "champion-portraits",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/minimap-model",
      "to": "minimap-model",
      "filter": [
        "**/*"
      ]
    }
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/prebuilds/win32-x64.node",
    "**/node_modules/onnxruntime-node/bin/napi-v6/win32/x64/onnxruntime_binding.node",
    "**/node_modules/onnxruntime-node/bin/napi-v6/win32/x64/onnxruntime.dll"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-Setup.${ext}"
  },
  "nsis": {
    "guid": "f055652a-03fc-5862-8fe3-2be04dffe9f6",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": [
    {
      "provider": "github",
      "owner": "KleinByte",
      "repo": "Recall",
      "releaseType": "release"
    }
  ]
}
