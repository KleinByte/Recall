{
  "name": "recall",
  "version": "3.4.1",
  "main": "dist-electron/main/index.js",
  "description": "Game tracking, grades, challenges, and insights.",
  "author": "KleinByte",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm theme:generate && vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:renderer": "pnpm theme:check && vite build",
    "package:smoke": "electron-builder --dir --publish never",
    "format:check": "node scripts/check-repository-hygiene.mjs",
    "theme:generate": "node scripts/generate-theme-colors.mjs",
    "theme:check": "node scripts/generate-theme-colors.mjs --check",
    "check:repo": "pnpm format:check && pnpm theme:check",
    "doctor:native": "node scripts/doctor-native.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm check:repo && pnpm typecheck && pnpm test && pnpm build:renderer && pnpm doctor:native",
    "verify:ci": "pnpm verify && pnpm test:e2e && pnpm package:smoke",
    "release": "pnpm store:package",
    "package:store": "electron-builder --config electron-builder.store.cjs --publish never",
    "store:defender": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/scan-store-installer.ps1",
    "store:installer-test": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-store-installer.ps1",
    "store:verify": "node scripts/verify-store-installer.cjs",
    "store:package": "pnpm verify && pnpm test:e2e && pnpm package:store && pnpm store:defender && pnpm store:verify",
    "release:signed": "pnpm store:package",
    "build": "pnpm verify && electron-builder",
    "preview": "vite preview",
    "sync:classic-items": "node scripts/sync-classic-items.mjs",
    "sync:rune-assets": "node scripts/sync-rune-assets.mjs",
    "sync:champion-classes": "node scripts/sync-champion-classes.mjs",
    "sync:champion-portraits": "node scripts/sync-champion-portraits.mjs",
    "minimap:roster:check-remote": "node scripts/sync-champion-portraits.mjs --check",
    "sync:minimap-model": "node scripts/sync-minimap-model.mjs",
    "sync:minimap-training-roster": "node scripts/sync-minimap-training-roster.mjs --update",
    "minimap:roster:check": "node scripts/sync-minimap-training-roster.mjs --check",
    "minimap:setup": "node scripts/setup-minimap-training.mjs",
    "minimap:download-base": "node scripts/download-minimap-training-base.mjs",
    "minimap:generate": "node scripts/run-minimap-training.mjs minimap_training.synthetic",
    "minimap:dataset:validate": "node scripts/run-minimap-training.mjs minimap_training.validate_dataset",
    "minimap:live:build": "node scripts/run-minimap-training.mjs minimap_training.live_regression",
    "minimap:checkpoint:expand": "node scripts/run-minimap-training.mjs minimap_training.expand_checkpoint",
    "minimap:train": "node scripts/run-minimap-training.mjs minimap_training.train",
    "minimap:evaluate": "node scripts/run-minimap-training.mjs minimap_training.evaluate",
    "minimap:publish": "node scripts/run-minimap-training.mjs minimap_training.publish",
    "minimap:pipeline": "node scripts/run-minimap-training.mjs minimap_training.pipeline",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "node scripts/rebuild-node-native.mjs",
    "rebuild:native": "pnpm rebuild:electron && pnpm rebuild:node",
    "postinstall": "pnpm rebuild:native",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.13.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.11",
    "better-sqlite3-node": "npm:better-sqlite3@13.0.3",
    "echarts": "6.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "happy-dom": "20.11.2",
    "node-abi": "4.33.0",
    "node-gyp": "13.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ws": "^8.21.3",
    "@techstark/opencv-js": "5.0.0-release.1",
    "onnxruntime-node": "1.27.0"
  }
}
