{
  "name": "recall",
  "version": "2.0.29",
  "main": "dist-electron/main/index.js",
  "description": "League of Legends challenge and ARAM stat tracker that remembers what the client forgets.",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "release": "pnpm typecheck && vite build && electron-builder --publish always",
    "release:signed": "pnpm typecheck && vite build && electron-builder --config electron-builder.azure.cjs --publish never",
    "build": "pnpm typecheck && vite build && electron-builder",
    "preview": "vite preview",
    "sync:classic-items": "node scripts/sync-classic-items.mjs",
    "sync:rune-assets": "node scripts/sync-rune-assets.mjs",
    "sync:champion-classes": "node scripts/sync-champion-classes.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20.19.43",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-vue": "^5.0.4",
    "better-sqlite3-node": "npm:better-sqlite3@12.11.1",
    "echarts": "6.1.0",
    "electron": "^29.1.1",
    "electron-builder": "^26.11.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "node-abi": "3.94.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "2.1.9",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.6"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  }
}
