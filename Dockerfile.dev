FROM node:24.19.0-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    g++ \
    libasound2 \
    libatspi2.0-0 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libxss1 \
    libxtst6 \
    make \
    novnc \
    openbox \
    python3 \
    websockify \
    x11vnc \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@11.22.0

WORKDIR /workspace

RUN mkdir /recall-data \
  && chown node:node /workspace /recall-data

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc electron-builder.json ./
COPY --chown=node:node scripts/rebuild-node-native.mjs ./scripts/rebuild-node-native.mjs

USER node

RUN pnpm install --frozen-lockfile

COPY --chown=node:node . ./
COPY --chown=node:node docker/start-dev.sh /usr/local/bin/start-recall-dev

RUN chmod +x /usr/local/bin/start-recall-dev

CMD ["/usr/local/bin/start-recall-dev"]
